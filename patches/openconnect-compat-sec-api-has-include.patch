 #include <inttypes.h>
 
 #ifdef _WIN32
+/* The legacy sec_api stdlib_s.h ships with MSVC-era Windows SDKs and was
+ * removed from recent mingw-w64 header packages. On MinGW the errno_t and
+ * size_t typedefs come from the standard headers via corecrt.h, and the
+ * getenv_s / _putenv_s prototypes this file declares itself below, so the
+ * include is only required where it actually exists. Feature-detect with
+ * __has_include to stay correct on both toolchains. */
+#if defined(_MSC_VER) || (defined(__has_include) && __has_include(<sec_api/stdlib_s.h>))
 #include <sec_api/stdlib_s.h> /* errno_t, size_t */
+#endif
